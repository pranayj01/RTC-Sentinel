POSTGRES_DB=rtc_sentinel
POSTGRES_USER=rtc_sentinel
POSTGRES_PASSWORD=rtc_sentinel
DATABASE_URL=postgresql://rtc_sentinel:rtc_sentinel@postgres:5432/rtc_sentinel?schema=public
REDIS_URL=redis://redis:6379
REALTIME_TTL_SECONDS=3600
PORT=3000
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_MS=2000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
REQUEST_BODY_LIMIT=64kb
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SOCKET_RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=1
TURN_EXTERNAL_IP=127.0.0.1
TURN_USERNAME=rtc-sentinel
TURN_CREDENTIAL=local-development-turn-secret
