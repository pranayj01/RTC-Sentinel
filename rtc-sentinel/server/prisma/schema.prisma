generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceHeartbeat {
  id        String   @id @default(cuid())
  service   String
  createdAt DateTime @default(now())

  @@index([service, createdAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  callsMade    Call[]   @relation("Caller")
  callsReceived Call[]  @relation("Receiver")
  callParticipants CallParticipant[]
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTED
  ENDED
  REJECTED
  FAILED
  MISSED
}

model Call {
  id         String            @id @default(cuid())
  roomId     String
  callerId   String
  receiverId String
  startedAt  DateTime          @default(now())
  endedAt    DateTime?
  duration   Int?
  status     CallStatus        @default(INITIATED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  caller     User              @relation("Caller", fields: [callerId], references: [id], onDelete: Restrict)
  receiver   User              @relation("Receiver", fields: [receiverId], references: [id], onDelete: Restrict)
  participants CallParticipant[]
  metrics      CallMetric[]

  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
  @@index([roomId])
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  userId   String
  joinedAt DateTime?
  leftAt   DateTime?
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([callId, userId])
  @@index([userId])
}

model CallMetric {
  id              String   @id @default(cuid())
  callId          String
  timestamp       DateTime @default(now())
  rtt             Float?
  jitter          Float?
  packetsSent     Int      @default(0)
  packetsReceived Int      @default(0)
  packetsLost     Int      @default(0)
  packetLoss      Float    @default(0)
  bytesSent       Int      @default(0)
  bytesReceived   Int      @default(0)
  bitrate         Float    @default(0)
  codec           String?
  audioLevel      Float?
  candidateType   String?
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, timestamp])
}
